{
  "name": "nazeer-desktop",
  "productName": "Nazeer Desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Nazeer Desktop: non-contact camel body measurement for Mzayen judging (operator app)",
  "author": "Nazeer",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write . ../tools --config .prettierrc.json",
    "format:check": "prettier --check . ../tools --config .prettierrc.json",
    "test": "vitest run",
    "test:store-real": "node scripts/store-real.mjs",
    "e2e": "electron-vite build && playwright test",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:codes": "node scripts/gen-engine-codes.mjs",
    "gen:cmap": "node scripts/gen-font-cmap.mjs",
    "fixtures": "node scripts/capture-fixtures.mjs",
    "export": "electron-vite build && electron . --export",
    "snap": "node scripts/snap.mjs",
    "stage:engine": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stage-engine.mjs",
    "dist": "node scripts/dist-checks.mjs && cross-env NAZEER_DIST=1 electron-vite build && npm run stage:engine && electron-builder --win --x64",
    "dist:dir": "node scripts/dist-checks.mjs && cross-env NAZEER_DIST=1 electron-vite build && npm run stage:engine && electron-builder --win --x64 --dir",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "check:sandbox": "node scripts/sandbox-check.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-direction": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@reduxjs/toolkit": "2.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "cross-env": "10.1.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
